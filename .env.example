# RevenueCat public SDK keys (safe to embed in the client — these are not secrets).
# Leave both unset for local development: the app falls back to a local dev-mode
# premium toggle (Settings -> Developer) instead of talking to RevenueCat.
#
# Get these from the RevenueCat dashboard: Project settings -> Apps -> your app -> API Keys.
# Setting these switches the app to real billing via react-native-purchases, which is a
# native module -- Expo Go can't load it, so you'll need a dev client build:
#   npx expo run:android   (or an EAS development build)
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=
